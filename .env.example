# Server-side only. Never put these values in browser code or a VITE_ variable.
PORT=4360
# Invited hosted identity is default-off. A complete reviewed configuration
# activates exact-origin routes and Secure cookies behind a TLS ingress.
# It does not provision Cognito, DNS, certificates, hosting, email or invitations.
# See docs/HOSTED-LAUNCH.md before setting any value.
ORIGIN_IDENTITY_MODE=off
ORIGIN_PUBLIC_ORIGIN=
ORIGIN_COGNITO_REGION=
ORIGIN_COGNITO_POOL_ID=
ORIGIN_COGNITO_DOMAIN_PREFIX=
ORIGIN_COGNITO_CLIENT_ID=
# Optional 64-character hex master key. Otherwise a local key is created.
ORIGIN_MASTER_KEY=
ORIGIN_DATA_DIR=
# No external model calls unless explicitly enabled and individually approved.
ORIGIN_EXTERNAL_AI=0
ORIGIN_OPENAI_KEY=
ORIGIN_OPENAI_MODEL=
# Optional JSON arrays of reviewed text-model IDs, e.g. ["model-a","model-b"].
# When provided, MODELS replaces MODEL (including []); no automatic discovery.
# ORIGIN_OPENAI_MODELS=[]
ORIGIN_OPENAI_ENABLED=1
ORIGIN_ANTHROPIC_KEY=
ORIGIN_ANTHROPIC_MODEL=
# ORIGIN_ANTHROPIC_MODELS=[]
ORIGIN_ANTHROPIC_ENABLED=1
ORIGIN_GEMINI_KEY=
ORIGIN_GEMINI_MODEL=
# ORIGIN_GEMINI_MODELS=[]
ORIGIN_GEMINI_ENABLED=0
# Operator review of actual account billing/data terms, not an attestation.
ORIGIN_GEMINI_POLICY_REVIEWED=0
ORIGIN_KIMI_KEY=
ORIGIN_KIMI_MODEL=
# ORIGIN_KIMI_MODELS=[]
ORIGIN_KIMI_ENABLED=0
ORIGIN_KIMI_POLICY_REVIEWED=0
# Attempt limit persists per account/day, including failed or uncertain calls.
ORIGIN_DAILY_REQUEST_LIMIT=20
# Required whenever external AI is enabled with managed hosted identity. The
# guard reserves a conservative maximum before the request reaches a provider.
ORIGIN_SPEND_GUARD=0
ORIGIN_ACCOUNT_MONTHLY_AI_BUDGET_USD=
ORIGIN_PLATFORM_MONTHLY_AI_BUDGET_USD=
# Versioned, operator-reviewed prices. Example schema only; verify current rates:
# {"version":"reviewed-v1","providers":{"openai":{"exact-model-id":{"inputUsdPerMillion":"0.00","outputUsdPerMillion":"0.00"}}}}
ORIGIN_MODEL_PRICES_JSON=
# Hosted billing adapter: off or stripe-test. Live billing is intentionally
# unavailable until refund/risk/tax policies and real acceptance are complete.
# Managed external AI requires both this entitlement gate and the spend guard.
ORIGIN_PAYMENTS_MODE=off
ORIGIN_REQUIRE_PAID_ENTITLEMENT=0
ORIGIN_STRIPE_SECRET_KEY=
ORIGIN_STRIPE_WEBHOOK_SECRET=
# Pin the same reviewed API version in Stripe and this configuration.
ORIGIN_STRIPE_API_VERSION=
# Example schema only; use actual test price IDs after reviewing Checkout:
# {"version":"reviewed-v1","tiers":{"builder":{"priceId":"price_REPLACE_ME","monthlyAiBudgetUsd":"20.00"}}}
ORIGIN_STRIPE_PRICE_MAP_JSON=
# Optional local description review. No cloud fallback and no automatic download.
ORIGIN_LOCAL_REVIEW=0
ORIGIN_LOCAL_REVIEW_MODEL=
# Exact 64-character installed model digest returned by Ollama /api/tags.
ORIGIN_LOCAL_REVIEW_DIGEST=
# Set only after verifying the Ollama service runs with OLLAMA_NO_CLOUD=1.
ORIGIN_LOCAL_REVIEW_OFFLINE_CONFIRMED=0
# Independent signed timestamps. Off until the authority and trust material are reviewed.
# See docs/TIMESTAMPS.md. These are server paths/pins, not browser settings.
ORIGIN_TSA_ENABLED=0
ORIGIN_TSA_POLICY_REVIEWED=0
ORIGIN_TSA_ROOT_FILE=
ORIGIN_TSA_SIGNER_FILE=
ORIGIN_TSA_CRL_FILE=
ORIGIN_TSA_ROOT_SHA256=
ORIGIN_TSA_SIGNER_SHA256=
ORIGIN_TSA_POLICY_OID=
ORIGIN_OPENSSL_PATH=
