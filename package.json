{
  "name": "origin-studio",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "vite build",
    "build:render": "vite build --config vite.render.config.mjs",
    "start:render": "node server/render-preview.mjs",
    "start": "node server/http.mjs",
    "start:connected": "node --env-file=.env.local server/http.mjs",
    "connect:openai": "node scripts/configure-openai.mjs",
    "test:live": "node --env-file=.env.local scripts/live-openai.mjs --run-live",
    "test": "node --test test/*.test.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:business": "node scripts/check-unit-economics.mjs",
    "release:check": "node scripts/check-public-release.mjs",
    "verify": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "7.3.6"
  }
}
